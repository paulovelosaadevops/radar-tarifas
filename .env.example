# Copie para .env.local e preencha. O .env.local não vai para o git.

# Chave do APInex (começa com sk-apx). Fica só no servidor.
APINEX_API_KEY=

# Opcional
APINEX_BASE_URL=https://api.apinex.bond/v1
# Só modelos gratuitos são aceitos (precisa começar com "free/")
APINEX_MODEL=free/deepseek-v4.1-flash

# Chave do SerpApi (preços reais de voos e hotéis). Fica só no servidor.
SERPAPI_API_KEY=
